# Private values: never put these in client code or public repositories.
FOUNDER_PIN=
COS_PIN=
SESSION_SECRET=
JOB_SECRET=
# Server-only Convex connection. Keep the bridge secret out of VITE_/NEXT_PUBLIC_ variables.
DATA_BACKEND=convex
CONVEX_URL=
PRECEDENT_BRIDGE_SECRET=
# Public PostHog project settings. These are configuration values, not personal API keys.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Localhost analytics stays off. Set to true only for a temporary verification run, never in production.
NEXT_PUBLIC_POSTHOG_ALLOW_LOCALHOST=false
# AI, email provider and a trusted scheduler still need configuration.
